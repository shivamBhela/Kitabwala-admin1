# Local dev placeholders — replace with your actual Postgres/Redis connection
# strings once your infra is ready. Nothing in this file is a real secret.

DATABASE_URL="postgresql://kitabwalah:kitabwalah@localhost:5432/kitabwalah?schema=public"
REDIS_URL="redis://localhost:6379"

# Set to "true" only while no real database exists yet — see AUTH_DEV_BYPASS
# comments in auth.service.ts / jwt.strategy.ts / prisma.service.ts.
AUTH_DEV_BYPASS=false

PORT=3001
CORS_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="__CHANGE_ME__"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

TOTP_ENCRYPTION_KEY="__CHANGE_ME__"

ANALYTICS_TIMEZONE="Asia/Kolkata"
SAME_DAY_CACHE_TTL_SECONDS=45

SEED_SUPER_ADMIN_PHONE="+919999999999"
SEED_SUPER_ADMIN_PASSWORD="__CHANGE_ME__"
