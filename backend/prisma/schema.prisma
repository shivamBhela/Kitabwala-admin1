model IssueReport {
  id              Int                 @id @default(autoincrement())
  user_id         Int
  order_id        Int?
  category        IssueCategory
  description     String
  status          SupportTicketStatus @default(open) // kitabwalah_schema.pdf types this as SupportTicketStatus, not a raw string — reuses the same enum as SupportTicket
  resolution_note String?
  created_at      DateTime            @default(now())
  updated_at      DateTime            @updatedAt

  user  User   @relation(fields: [user_id], references: [id])
  order Order? @relation(fields: [order_id], references: [id])

  @@map("issue_reports")
}

model PaymentWebhook {
  id         Int      @id @default(autoincrement())
  wp_id      Int?
  gateway    String
  event      String
  payload    Json
  processed  Boolean  @default(false)
  order_id   Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  order Order? @relation(fields: [order_id], references: [id])

  @@map("payment_webhooks")
}

model EmailLog {
  id         Int       @id @default(autoincrement())
  wp_id      Int?
  to_email   String
  subject    String
  message    String
  status     String
  sent_at    DateTime?
  created_at DateTime  @default(now())

  @@map("email_logs")
}

model Certificate {
  id              Int       @id @default(autoincrement())
  wp_id           Int?
  user_id         Int? // intentionally NOT a foreign key — migrated wp_id reference per kitabwalah_schema.pdf ("FK not enforced — migrated user wp_id ref"); kept for verification only
  user_email      String?
  course_title    String?
  issued_at       DateTime?
  certificate_url String?
  created_at      DateTime  @default(now())

  @@map("certificates")
}

model MigrationRunLog {
  id                Int             @id @default(autoincrement())
  source_db         String
  source_table      String
  destination_table String
  records_migrated  Int             @default(0)
  records_failed    Int             @default(0)
  records_skipped   Int             @default(0)
  status            MigrationStatus @default(running)
  error_log         String?
  started_at        DateTime        @default(now())
  completed_at      DateTime?
  created_at        DateTime        @default(now())

  @@map("migration_run_logs")
}

// ─── Additive — not in either the Kitabwalah or UsedBooks schema spec. ─────────
// Site-wide festive theming ("switch the whole app's look for Diwali/Republic Day/
// etc., like other consumer apps do"), requested directly by the admin. `colors` is
// a partial override map of design-token names (matching kitabwalah-admin's
// styles/theme.css custom properties, e.g. {"brand-primary": "28 100% 50%",
// "yellow": "#FF6F00"}) merged onto the base palette when this theme is active —
// deliberately flexible rather than one fixed column per token, so new tokens don't
// need a migration to become themeable.

model SiteTheme {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  colors      Json // partial {token_name: value} override map — see note above
  is_active   Boolean   @default(false) // exactly one row should be true at a time; activate() enforces this
  is_default  Boolean   @default(false) // fallback theme when nothing else is active/in-window; exactly one row should be true
  valid_from  DateTime? // optional auto-scheduling — if set, only "active" within [valid_from, valid_until]
  valid_until DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("site_themes")
}
