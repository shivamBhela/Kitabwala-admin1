  created_at   DateTime    @default(now())
  updated_at   DateTime    @updatedAt

  @@map("homepage_pins")
}

model CompetitiveExam {
  id            Int              @id @default(autoincrement())
  name          String
  slug          String           @unique
  description   String?
  image_url     String?
  display_order Int              @default(0)
  is_active     Boolean          @default(true)
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt
