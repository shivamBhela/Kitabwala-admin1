}

model ExamCollection {
  id            Int      @id @default(autoincrement())
  exam_id       Int
  product_id    Int?
  category_id   Int?
  display_order Int      @default(0)
  added_at      DateTime @default(now())

  exam     CompetitiveExam @relation(fields: [exam_id], references: [id])
