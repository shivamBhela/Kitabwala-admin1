// Kitabwalah schema (see kitabwalah_schema.pdf, 46 models / 30 enums) — built
// incrementally. Phase 1 covered core commerce + auth/Same-Day-Analytics.
// This pass ("high-priority sections first") adds the models needed to make
// Products, Withdrawals, App Settings, and User reseller-management real:
// Category, ProductCategory, ProductImage, ProductAttribute, ProductCityPrice,
// WithdrawalRequest, AppSetting, UserSavedAddress, Reseller, ResellerReferral.
//
// Reconciliation note: kitabwalah_schema.pdf's own Product field reference does
// not list status/approved_by_id/approved_at/rejection_reason/featured_until/
// meta_title/meta_description — but the ProductStatus enum IS declared at the
// top level for this database, and kitabwalah_admin_portal.pdf's Product
// Management section explicitly requires an approve/reject/status/
// rejection_reason/approved_by_id/approved_at/featured_until workflow. The
// sibling usedbooks_schema.pdf's Product model (same conceptual entity, richer
// field list) includes exactly these fields. Treating this as a documentation
// gap in the schema PDF rather than a deliberate omission, these fields are
// added here to satisfy the admin-portal spec without contradicting either
// document. `returnable`/`return_window` from the usedbooks Product model are
// NOT added — kitabwalah_admin_portal.pdf describes returns as a single global
// policy (AppSetting.return_window_days), not a per-product override.
//
// Still deferred to later phases: Wishlist, BookSwipe, ProductReview,
// DeviceToken, Notification, Banner, HomepagePin, CompetitiveExam,
// ExamCollection, StaticPage, SearchHistory, CartItem, StoreFollower,
// SupportTicket, IssueReport, PaymentWebhook, EmailLog, Certificate,
// MigrationRunLog, UserCoupon.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (subset of the 30-enum spec, matching the models implemented here) ──

enum UserRole {
  customer
  vendor
  admin
  delivery_person
  reseller
}

enum AuthProvider {
  phone
  google
  email
}

enum BookFormat {
  physical
  audio
  ebook
}

enum BookCondition {
  new_condition
  like_new
  good
  acceptable
  poor
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  out_for_delivery
  delivered
  cancelled
  return_requested
  returned
}

enum OrderItemStatus {
  active
  return_requested
  returned
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
}

enum PaymentMethod {
  razorpay
  cashfree
  cod
  wallet
}

enum DeliveryType {
  same_day
  normal
}

enum ShipmentStatus {
  pending
  assigned
  picked_up
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  returned_to_seller
}

enum CouponType {
  percentage
  fixed_amount
}

enum ReturnReason {
  wrong_item
  damaged_in_transit
  not_as_described
  missing_pages
  other
}

enum ReturnRequestStatus {
  pending
  approved
  rejected
  pickup_scheduled
  picked_up
  refund_initiated
  completed
}

enum RefundMethod {
  original_payment
  wallet
}

enum DeliveryZone {
  local
  rest_bihar
  south_india
  rest_india
}

enum CodType {
  full_cod
  partial_cod
  prepaid_only
}

enum WalletTransactionType {
  credit
  debit
}

enum WalletTransactionSource {
  order_payment
  order_refund
  referral_reward
  reseller_commission
  top_up
  withdrawal_reversal
  admin_credit
  admin_debit
}

enum VendorSettlementStatus {
  pending
  processing
  completed
  failed
}

enum AdminActionType {
  user_ban
  user_unban
  product_approve
  product_reject
  vendor_verify
  vendor_suspend
  order_refund
  withdrawal_approve
  withdrawal_reject
  withdrawal_complete
  wallet_adjustment
  coupon_create
  coupon_deactivate
  banner_update
  pincode_update
  settings_update
  // Additive — auth/RBAC events not in the original spec, needed by the audit module
  login
  logout
  two_factor_enabled
  refresh_token_reuse_detected
  admin_role_change
  // Additive — Vendor Management admin actions beyond the spec's vendor_verify/
  // vendor_suspend pair (commission override, reactivation, bank detail edits,
  // vacation mode toggle), needed by the vendors module.
  vendor_reactivate
  vendor_commission_update
  vendor_bank_update
  vendor_vacation_mode
  // Additive — Delivery Management admin actions (delivery person CRUD, shipment
  // assignment, force status updates), needed by the delivery module.
  delivery_person_create
  delivery_person_update
  delivery_person_deactivate
  shipment_assign
  shipment_status_update
  // Additive — Product Management admin actions beyond approve/reject that the original
  // spec's AdminActionType enum didn't anticipate but the admin portal's Product/Category
  // CRUD + feature/city-price/bulk-deactivate workflow needs for a complete audit trail.
  // Bulk-approve intentionally reuses product_approve rather than adding another value.
  product_create
  product_update
  product_bulk_deactivate
  category_create
  category_update
  // Additive — Order Management admin actions beyond order_refund (already in the
  // original spec), needed by the orders module: manual lifecycle status changes,
  // admin-initiated cancellation (distinct from the refund it may trigger, which is
  // still logged as order_refund), and on-demand invoice number generation.
  order_status_update
  order_cancel
  order_invoice_generated
  // Additive — not in either the Kitabwalah or UsedBooks schema spec at all. Site-wide
  // festive theming, requested directly by the admin outside the original PDFs.
  theme_create
  theme_update
  theme_activate
}

/// Not in the original spec — admin-portal RBAC, additive on top of AdminProfile.
enum AdminRole {
  super_admin
  ops
  finance
  analytics_viewer
  support
}

// ─── Core commerce models (01. User, 02. VendorProfile, 06. Product, 11-14.
//     Order/OrderItem/OrderAddress/VendorOrderItem, 16-17. DeliveryPerson/
//     Shipment, 18-19. Coupon/CouponUsage, 38. WalletTransaction,
//     37. ReturnRequest, 04-05. City/Pincode, 44. AdminActionLog) ──

model User {
  id                   Int          @id @default(autoincrement())
  wp_id                Int?
  user_code            String       @unique @db.VarChar(12) // immutable, e.g. USR000001/VEN000001/ADM000001 — never reassigned
  phone                String?      @unique
  phone_verified       Boolean      @default(false)
  email                String?      @unique
  email_verified       Boolean      @default(false)
  password_hash        String? // legacy migrated users + admin/staff logins only, not exposed in customer UI
  auth_provider        AuthProvider
  google_id            String?      @unique
  display_name         String
  first_name           String?
  last_name            String?
  profile_picture      String?
  role                 UserRole
  referral_code        String?      @unique
  referred_by_id       Int?
  referred_by          User?        @relation("UserReferral", fields: [referred_by_id], references: [id])
  referrals            User[]       @relation("UserReferral")
  detected_city_id     Int?
  detected_city        City?        @relation(fields: [detected_city_id], references: [id])
  detected_pincode     String?
  wallet_balance       Decimal      @default(0) @db.Decimal(12, 2)
  is_active            Boolean      @default(true)
  is_banned            Boolean      @default(false)
  ban_reason           String?
  is_migrated          Boolean      @default(false)
  migration_login_done Boolean      @default(false)
  token_version        Int          @default(0) // bump to invalidate all live access tokens (ban, password reset)
  last_login_at        DateTime?
  created_at           DateTime     @default(now())
  updated_at           DateTime     @updatedAt

  vendor_profile      VendorProfile?
  delivery_person     DeliveryPerson?
  admin_profile       AdminProfile?
  two_factor_auth     TwoFactorAuth?
  refresh_tokens      RefreshToken[]
  orders              Order[]
  wallet_transactions WalletTransaction[]
  return_requests     ReturnRequest[]
  coupon_usages       CouponUsage[]
  admin_action_logs   AdminActionLog[]    @relation("AdminActionLogAdmin")

  reseller           Reseller?
  referred_referrals ResellerReferral?  @relation("ReferredUser")
  product_reviews    ProductReview[]
  wishlists          Wishlist[]
  book_swipes        BookSwipe[]
  saved_addresses    UserSavedAddress[]
  user_coupons       UserCoupon[]
  search_history     SearchHistory[]
  cart_items         CartItem[]
  device_tokens      DeviceToken[]
  notifications      Notification[]
  store_followers    StoreFollower[]
  support_tickets    SupportTicket[]
  issue_reports      IssueReport[]
  // No `certificates` back-relation: Certificate.user_id is intentionally not a real FK (see Certificate model).

  @@map("users")
}

model VendorProfile {
  id                  Int      @id @default(autoincrement())
  wp_id               Int?
  user_id             Int      @unique
  user                User     @relation(fields: [user_id], references: [id])
  store_name          String
  store_slug          String   @unique
  store_description   String?
  store_logo          String?
  store_banner        String?
  phone               String?
  address             String?
  city                String?
  state               String?
  pincode             String?
  country             String?
  gstin               String?
  pan_number          String?
  bank_account_number String?
  bank_ifsc           String?
  bank_account_name   String?
  upi_id              String?
  commission_rate     Decimal  @default(10) @db.Decimal(5, 2)
  total_earnings      Decimal  @default(0) @db.Decimal(12, 2)
  total_withdrawn     Decimal  @default(0) @db.Decimal(12, 2)
  pending_balance     Decimal  @default(0) @db.Decimal(12, 2)
  average_rating      Decimal  @default(0) @db.Decimal(3, 2)
  total_reviews       Int      @default(0)
  total_orders        Int      @default(0)
  total_products      Int      @default(0)
  is_verified         Boolean  @default(false)
  kyc_form_data       Json?
  vacation_mode       Boolean  @default(false)
  vacation_message    String?
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  products           Product[]
  order_items        OrderItem[]
  vendor_order_items VendorOrderItem[]

  product_reviews     ProductReview[]
  cart_items          CartItem[]
  withdrawal_requests WithdrawalRequest[]
  store_followers     StoreFollower[]
  support_tickets     SupportTicket[]

  @@map("vendor_profiles")
}

model Product {
  id                    Int           @id @default(autoincrement())
  wp_id                 Int?
  vendor_id             Int
  vendor                VendorProfile @relation(fields: [vendor_id], references: [id])
  title                 String
  slug                  String        @unique
  description           String?
  short_description     String?
  regular_price         Decimal       @db.Decimal(12, 2)
  sale_price            Decimal?      @db.Decimal(12, 2)
  base_price            Decimal?      @db.Decimal(12, 2) // price before GST (new platform)
  gst_rate              Decimal       @default(0) @db.Decimal(5, 2) // 0% books, 18% stationery
  hsn_code              String?
  sku                   String?       @unique
  isbn                  String?
  author                String?
  publisher             String?
  edition               String?
  language              String?
  pages                 Int?
  binding               String?
  genre                 String?
  book_format           BookFormat
  condition             BookCondition
  condition_description String?
  stock_quantity        Int           @default(0)
  manage_stock          Boolean       @default(true)
  in_stock              Boolean       @default(true)
  sold_count            Int           @default(0)
  weight                Decimal?      @db.Decimal(8, 3)
  dimensions            Json?
  // Reconciled from usedbooks_schema.pdf's Product model + kitabwalah_admin_portal.pdf's
  // Product Management section — see header note. ProductStatus is declared as an enum
  // in kitabwalah_schema.pdf but was never applied to a field; these fields make the
  // approve/reject/feature workflow the admin spec requires actually representable.
  status                ProductStatus @default(pending_review)
  meta_title            String?
  meta_description      String?
  approved_by_id        Int?
  approved_at           DateTime?
  rejection_reason      String?
  featured_until        DateTime?
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt

  order_items OrderItem[]

  product_categories ProductCategory[]
  images             ProductImage[]
  attributes         ProductAttribute[]
  city_prices        ProductCityPrice[]
  reviews            ProductReview[]
  wishlists          Wishlist[]
  book_swipes        BookSwipe[]
  cart_items         CartItem[]
  exam_collections   ExamCollection[]

  @@map("products")
}

model City {
  id         Int      @id @default(autoincrement())
  name       String
  slug       String   @unique
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pincodes Pincode[]
  orders   Order[]
  users    User[]

  product_city_prices ProductCityPrice[]
  cart_items          CartItem[]

  @@map("cities")
}

model Pincode {
  id                    Int          @id @default(autoincrement())
  pincode               String       @unique
  city_id               Int
  city                  City         @relation(fields: [city_id], references: [id])
  delivery_zone         DeliveryZone
  cod_type              CodType      @default(full_cod)
  partial_cod_amount    Decimal?     @db.Decimal(12, 2) // set only if cod_type = partial_cod
  is_same_day_eligible  Boolean      @default(false)
  is_delivery_available Boolean      @default(true)
  created_at            DateTime     @default(now())
  updated_at            DateTime     @updatedAt

  @@map("pincodes")
}

model Order {
  id                     Int           @id @default(autoincrement())
  wp_id                  Int?
  order_number           String        @unique // e.g. "KW-2026-00001"
  user_id                Int
  user                   User          @relation(fields: [user_id], references: [id])
  status                 OrderStatus   @default(pending)
  payment_status         PaymentStatus @default(pending)
  payment_method         PaymentMethod
  subtotal               Decimal       @db.Decimal(12, 2)
  shipping_amount        Decimal       @default(0) @db.Decimal(12, 2)
  cod_charge             Decimal       @default(0) @db.Decimal(12, 2)
  discount_amount        Decimal       @default(0) @db.Decimal(12, 2)
  gst_amount             Decimal       @default(0) @db.Decimal(12, 2) // product GST
  shipping_gst_amount    Decimal       @default(0) @db.Decimal(12, 2) // 18% on shipping
  platform_fee           Decimal       @default(0) @db.Decimal(12, 2) // reserved for future platform charges
  wallet_amount_used     Decimal       @default(0) @db.Decimal(12, 2)
  total                  Decimal       @db.Decimal(12, 2)
  coupon_code            String?
  coupon_id              Int?
  coupon                 Coupon?       @relation(fields: [coupon_id], references: [id])
  is_cod                 Boolean       @default(false)
  delivery_type          DeliveryType
  city_id                Int?
  city                   City?         @relation(fields: [city_id], references: [id])
  pincode                String?
  invoice_number         String?
  razorpay_order_id      String?
  razorpay_payment_id    String?
  razorpay_signature     String?
  cashfree_order_id      String?
  cashfree_payment_id    String?
  expected_delivery_date DateTime?
  delivered_at           DateTime?
  cancelled_at           DateTime?
  cancellation_reason    String?
  refund_amount          Decimal?      @db.Decimal(12, 2)
  refunded_at            DateTime?
  customer_note          String?
  created_at             DateTime      @default(now())
  updated_at             DateTime      @updatedAt

  order_items         OrderItem[]
  order_addresses     OrderAddress[]
  vendor_order_items  VendorOrderItem[]
  shipments           Shipment[]
  return_requests     ReturnRequest[]
  wallet_transactions WalletTransaction[]
  coupon_usages       CouponUsage[]

  product_reviews   ProductReview[]
  reseller_referral ResellerReferral?
  support_tickets   SupportTicket[]
  issue_reports     IssueReport[]
  payment_webhooks  PaymentWebhook[]

  @@map("orders")
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  wp_id         Int?
  order_id      Int
  order         Order           @relation(fields: [order_id], references: [id])
  product_id    Int
  product       Product         @relation(fields: [product_id], references: [id])
  vendor_id     Int
  vendor        VendorProfile   @relation(fields: [vendor_id], references: [id])
  product_name  String // snapshot at time of order
  product_image String?
  sku           String?
  unit_price    Decimal         @db.Decimal(12, 2)
  quantity      Int
  total_price   Decimal         @db.Decimal(12, 2)
  gst_rate      Decimal         @default(0) @db.Decimal(5, 2)
  gst_amount    Decimal         @default(0) @db.Decimal(12, 2)
  status        OrderItemStatus @default(active)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  vendor_order_item VendorOrderItem?
  return_requests   ReturnRequest[]

  @@map("order_items")
}

model OrderAddress {
  id           Int      @id @default(autoincrement())
  wp_id        Int?
  order_id     Int
  order        Order    @relation(fields: [order_id], references: [id])
  address_type String // billing | shipping
  first_name   String?
  last_name    String?
  company      String?
  address_1    String?
  address_2    String?
  city         String?
  state        String?
  pincode      String?
  country      String?
  phone        String?
  email        String?
  created_at   DateTime @default(now())

  @@map("order_addresses")
}

model VendorOrderItem {
  id                Int                    @id @default(autoincrement())
  wp_id             Int?
  order_id          Int
  order             Order                  @relation(fields: [order_id], references: [id])
  order_item_id     Int                    @unique
  order_item        OrderItem              @relation(fields: [order_item_id], references: [id])
  vendor_id         Int
  vendor            VendorProfile          @relation(fields: [vendor_id], references: [id])
  commission_rate   Decimal                @db.Decimal(5, 2)
  commission_amount Decimal                @db.Decimal(12, 2)
  vendor_earning    Decimal                @db.Decimal(12, 2)
  invoice_number    String?
  status            OrderStatus            @default(pending)
  settlement_status VendorSettlementStatus @default(pending)
  settled_at        DateTime?
  created_at        DateTime               @default(now())
  updated_at        DateTime               @updatedAt

  @@map("vendor_order_items")
}

model Coupon {
  id                  Int        @id @default(autoincrement())
  wp_id               Int?
  code                String     @unique
  description         String?
  type                CouponType
  value               Decimal    @db.Decimal(12, 2) // % value or Rs. fixed amount
  min_order_amount    Decimal?   @db.Decimal(12, 2) // null = no minimum
  max_discount_amount Decimal?   @db.Decimal(12, 2) // cap for % coupons
  is_user_specific    Boolean    @default(false)
  is_birthday_coupon  Boolean    @default(false) // auto-applies in birthday month
  is_first_order_only Boolean    @default(false)
  usage_limit         Int? // null = unlimited
  used_count          Int        @default(0)
  valid_from          DateTime?
  valid_until         DateTime?
  is_active           Boolean    @default(true)
  created_at          DateTime   @default(now())
  updated_at          DateTime   @updatedAt

  orders        Order[]
  coupon_usages CouponUsage[]

  user_coupons UserCoupon[]

  @@map("coupons")
}

model CouponUsage {
  id               Int      @id @default(autoincrement())
  coupon_id        Int
  coupon           Coupon   @relation(fields: [coupon_id], references: [id])
  user_id          Int
  user             User     @relation(fields: [user_id], references: [id])
  order_id         Int
  order            Order    @relation(fields: [order_id], references: [id])
  discount_applied Decimal  @db.Decimal(12, 2)
  used_at          DateTime @default(now())

  @@map("coupon_usages")
}

model WalletTransaction {
  id             Int                     @id @default(autoincrement())
  user_id        Int
  user           User                    @relation(fields: [user_id], references: [id])
  type           WalletTransactionType
  source         WalletTransactionSource
  amount         Decimal                 @db.Decimal(12, 2)
  balance_after  Decimal                 @db.Decimal(12, 2) // running balance snapshot
  order_id       Int?
  order          Order?                  @relation(fields: [order_id], references: [id])
  description    String?
  transaction_id String? // Razorpay/Cashfree payment ID for top-ups
  created_at     DateTime                @default(now())

  @@map("wallet_transactions")
}

model ReturnRequest {
  id                 Int                 @id @default(autoincrement())
  order_id           Int
  order              Order               @relation(fields: [order_id], references: [id])
  order_item_id      Int
  order_item         OrderItem           @relation(fields: [order_item_id], references: [id])
  user_id            Int
  user               User                @relation(fields: [user_id], references: [id])
  reason             ReturnReason
  reason_description String?
  proof_images       String[]            @default([])
  status             ReturnRequestStatus @default(pending)
  refund_amount      Decimal?            @db.Decimal(12, 2)
  refund_method      RefundMethod?
  admin_note         String?
  reviewed_by_id     Int? // admin user id, intentionally no FK constraint (matches source spec)
  reviewed_at        DateTime?
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt

  @@map("return_requests")
}

model DeliveryPerson {
  id                   Int       @id @default(autoincrement())
  user_id              Int       @unique
  user                 User      @relation(fields: [user_id], references: [id])
  name                 String
  phone                String
  photo                String?
  vehicle_type         String? // bike | cycle | auto
  vehicle_number       String?
  last_location_lat    Decimal?  @db.Decimal(10, 6)
  last_location_lng    Decimal?  @db.Decimal(10, 6)
  last_location_update DateTime?
  is_available         Boolean   @default(true)
  is_active            Boolean   @default(true)
  salary_per_month     Decimal?  @db.Decimal(12, 2)
  per_delivery_charge  Decimal?  @db.Decimal(12, 2)
  per_km_charge        Decimal?  @db.Decimal(12, 2)
  joined_at            DateTime  @default(now())
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  shipments Shipment[]

  @@map("delivery_persons")
}

model Shipment {
  id                      Int             @id @default(autoincrement())
  order_id                Int
  order                   Order           @relation(fields: [order_id], references: [id])
  delivery_person_id      Int? // null = Shadowfax/external
  delivery_person         DeliveryPerson? @relation(fields: [delivery_person_id], references: [id])
  delivery_type           DeliveryType
  status                  ShipmentStatus  @default(pending)
  tracking_id             String?
  shadowfax_order_id      String?
  pickup_otp              String?
  delivery_otp            String?
  otp_verified_at         DateTime?
  estimated_delivery_date DateTime?
  actual_delivered_at     DateTime?
  delivery_photo_url      String?
  delivery_attempts       Int             @default(0)
  last_attempt_at         DateTime?
  failed_reason           String?
  rescheduled_for         DateTime?
  created_at              DateTime        @default(now())
  updated_at              DateTime        @updatedAt

  @@map("shipments")
}

model AdminActionLog {
  id           Int             @id @default(autoincrement())
  admin_id     Int
  admin        User            @relation("AdminActionLogAdmin", fields: [admin_id], references: [id])
  action_type  AdminActionType
  target_table String?
  target_id    String?
  description  String?
  old_data     Json?
  new_data     Json?
  created_at   DateTime        @default(now())

  @@map("admin_action_logs")
}

// ─── Additive Phase 1 models (not in the original 46-model spec) ───────────
// RBAC, 2FA, and refresh-token rotation for the admin portal's own auth system.

model AdminProfile {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique
  user       User      @relation(fields: [user_id], references: [id])
  admin_role AdminRole
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@map("admin_profiles")
}

model TwoFactorAuth {
  id                Int       @id @default(autoincrement())
  user_id           Int       @unique
  user              User      @relation(fields: [user_id], references: [id])
  secret            String // AES-256-GCM ciphertext of the base32 TOTP secret
  is_enabled        Boolean   @default(false)
  backup_codes_hash String[]  @default([]) // bcrypt hash per one-time recovery code, removed from array on use
  last_used_at      DateTime?
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  @@map("two_factor_auth")
}

model RefreshToken {
  id             Int      @id @default(autoincrement())
  user_id        Int
  user           User     @relation(fields: [user_id], references: [id])
  token_hash     String   @unique // SHA-256 of the raw token; raw value is never persisted
  family_id      String
  is_revoked     Boolean  @default(false)
  replaced_by_id Int?
  expires_at     DateTime
  created_at     DateTime @default(now())
  ip_address     String?
  user_agent     String?

  @@index([user_id])
  @@index([family_id])
  @@map("refresh_tokens")
}

// --- New Enums ---
enum OtpPurpose {
  phone_login
  email_verify
  phone_verify
}

enum ProductStatus {
  draft
  pending_review
  active
  inactive
  rejected
}

enum WithdrawalStatus {
  pending
  approved
  processing
  completed
  rejected
}

enum NotificationType {
  order_placed
  order_confirmed
  order_shipped
  order_delivered
  order_cancelled
  payment_received
  review_posted
  promotional
  system
}

enum SupportTicketStatus {
  open
  in_progress
  resolved
  closed
}

enum IssueCategory {
  delivery
  payment
  product
  account
  other
}

enum MigrationStatus {
  running
  completed
  failed
}

enum DevicePlatform {
  android
  ios
  web
}

enum HomepinType {
  product
  category
  banner
}

enum BannerActionType {
  product
  category
  url
  none
}

// --- New Models ---

model Category {
  id                 Int               @id @default(autoincrement())
  wp_id              Int?
  name               String
  slug               String            @unique
  description        String?
  parent_id          Int?
  parent             Category?         @relation("CategoryToCategory", fields: [parent_id], references: [id])
  subcategories      Category[]        @relation("CategoryToCategory")
  image_url          String?
  display_order      Int               @default(0)
  is_active          Boolean           @default(true)
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  product_categories ProductCategory[]
  exam_collections   ExamCollection[]

  @@map("categories")
}

model ProductCategory {
  product_id  Int
  category_id Int
  product     Product  @relation(fields: [product_id], references: [id])
  category    Category @relation(fields: [category_id], references: [id])

  @@id([product_id, category_id])
  @@map("product_categories")
}

model ProductImage {
  id             Int      @id @default(autoincrement())
  wp_id          Int?
  product_id     Int
  product        Product  @relation(fields: [product_id], references: [id])
  image_versions Json
  is_primary     Boolean  @default(false)
  display_order  Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("product_images")
}

model ProductAttribute {
  id              Int      @id @default(autoincrement())
  product_id      Int
  product         Product  @relation(fields: [product_id], references: [id])
  attribute_name  String
  attribute_value String
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("product_attributes")
}

model ProductCityPrice {
  id         Int      @id @default(autoincrement())
  product_id Int
  city_id    Int
  price      Decimal  @db.Decimal(12, 2)
  product    Product  @relation(fields: [product_id], references: [id])
  city       City     @relation(fields: [city_id], references: [id])
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([product_id, city_id])
  @@map("product_city_prices")
}

model ProductReview {
  id                   Int      @id @default(autoincrement())
  wp_id                Int?
  product_id           Int
  vendor_id            Int
  user_id              Int
  order_id             Int?
  rating               Int
  title                String?
  content              String
  images               String[] @default([])
  is_verified_purchase Boolean  @default(false)
  status               String   @default("pending") // e.g. pending, approved, rejected
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  product Product       @relation(fields: [product_id], references: [id])
  vendor  VendorProfile @relation(fields: [vendor_id], references: [id])
  user    User          @relation(fields: [user_id], references: [id])
  order   Order?        @relation(fields: [order_id], references: [id])

  @@map("product_reviews")
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id])
  @@map("wishlists")
}

model BookSwipe {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  action     String // e.g. liked, disliked
  created_at DateTime @default(now())

  user    User    @relation(fields: [user_id], references: [id])
  product Product @relation(fields: [product_id], references: [id])

  @@map("book_swipes")
}

model UserSavedAddress {
  id         Int      @id @default(autoincrement())
  user_id    Int
  label      String // home | work | other
  first_name String?
  last_name  String?
  phone      String?
  address_1  String
  address_2  String?
  city       String
  state      String
  pincode    String
  country    String
  latitude   Decimal? @db.Decimal(10, 6)
  longitude  Decimal? @db.Decimal(10, 6)
  is_default Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id])

  @@map("user_saved_addresses")
}

model UserCoupon {
  id          Int       @id @default(autoincrement())
  user_id     Int
  coupon_id   Int
  assigned_at DateTime  @default(now())
  expires_at  DateTime?

  user   User   @relation(fields: [user_id], references: [id])
  coupon Coupon @relation(fields: [coupon_id], references: [id])

  @@map("user_coupons")
}

model Reseller {
  id              Int      @id @default(autoincrement())
  user_id         Int      @unique
  referral_code   String   @unique
  total_referrals Int      @default(0)
  total_earnings  Decimal  @default(0) @db.Decimal(12, 2)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user      User               @relation(fields: [user_id], references: [id])
  referrals ResellerReferral[]

  @@map("resellers")
}

model ResellerReferral {
  id                Int       @id @default(autoincrement())
  reseller_id       Int
  referred_user_id  Int       @unique
  first_order_id    Int?      @unique
  commission_amount Decimal   @default(0) @db.Decimal(12, 2)
  credited_at       DateTime?
  created_at        DateTime  @default(now())

  reseller      Reseller @relation(fields: [reseller_id], references: [id])
  referred_user User     @relation("ReferredUser", fields: [referred_user_id], references: [id])
  first_order   Order?   @relation(fields: [first_order_id], references: [id])

  @@map("reseller_referrals")
}

model SearchHistory {
  id         Int      @id @default(autoincrement())
  user_id    Int
  query      String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@map("search_history")
}

model CartItem {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  vendor_id  Int
  quantity   Int      @default(1)
  city_id    Int? // determines which ProductCityPrice applies, if any
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user    User          @relation(fields: [user_id], references: [id])
  product Product       @relation(fields: [product_id], references: [id])
  vendor  VendorProfile @relation(fields: [vendor_id], references: [id])
  city    City?         @relation(fields: [city_id], references: [id])

  @@unique([user_id, product_id, vendor_id])
  @@map("cart_items")
}

model DeviceToken {
  id         Int            @id @default(autoincrement())
  user_id    Int
  token      String         @unique
  platform   DevicePlatform
  is_active  Boolean        @default(true)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt

